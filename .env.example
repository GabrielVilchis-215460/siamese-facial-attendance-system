# Base de datos
POSTGRES_USER=asistencia
POSTGRES_PASSWORD=cambia_esta_contrasena
POSTGRES_DB=asistencia

#  Backend 
# Distancia euclidiana máxima (embeddings L2-normalizados) para aceptar una identidad.
# Se calibra con el conjunto de validación; este valor es solo un punto de partida.
UMBRAL_DISTANCIA=0.8
# Minutos de tolerancia para considerar una entrada como puntual.
TOLERANCIA_MINUTOS=10
# Segundos mínimos entre dos registros del mismo docente (anti-rebote).
ANTIREBOTE_SEGUNDOS=60
ZONA_HORARIA=America/Ciudad_Juarez

# Nginx / HTTPS
# La cámara web solo funciona en localhost o con HTTPS. Si accedes desde otro equipo
# de la red, agrega la IP del servidor, ej: DNS:localhost,IP:127.0.0.1,IP:192.168.1.50
CERT_SAN=DNS:localhost,IP:127.0.0.1
HTTPS_PORT=8443
HTTP_PORT=8080
